NOTION_TOKEN=your_integration_token_here
NOTION_PAGE_ID=your_database_id_here

# Property Names Configuration (Match your Notion Database headers)
STATUS_PROPERTY_NAME=状态
NUMBER_PROPERTY_NAME=编号
NAME_PROPERTY_NAME=名称
FILES_PROPERTY_NAME=文件和媒体
# Workflow Configuration
# The status value to filter for (e.g. "1-发票+购买记录")
STATUS_TO_PROCESS=2-已处理
# The status value to update to after processing (e.g. "2-已处理")
STATUS_PROCESSED=3-打印出来

# Run mode: "pdf" (default, 生成 PDF 并更新状态), "download" (只下载文件), "fapiao" (状态=2 时只下载 PDF 到 FAPIAO_DIR 且不更新状态)
MODE=pdf
FAPIAO_DIR=data/fapiao